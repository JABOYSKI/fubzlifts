# Copy this file to `tools/.env` and fill in your values.
# `tools/.env` is gitignored — it is NEVER committed and NEVER shipped to the
# browser. It is only read by tools/generate-clips.mjs on your machine.
#
# ⚠️  Put your real key in tools/.env, NOT in this .example file —
#     this template IS committed to git.

# ── REQUIRED ──────────────────────────────────────────────
# Your xAI API key (https://console.x.ai → API Keys).
XAI_API_KEY=xai-PASTE_YOUR_KEY_HERE

# ── RECOMMENDED (image-to-video, keeps every clip the same cat) ───
# A PUBLIC url to the seed photo. Easiest: upload cat-base.jpg to your public
# Supabase `companion` bucket, then paste its public URL here. A local file
# path also works (it gets base64-encoded), but a public URL is most reliable.
# Leave blank to do text-to-video instead (cat will NOT look like your cat).
SEED_IMAGE_URL=

# ── OPTIONAL: auto-upload finished clips to Supabase ──────
# If both are set, each downloaded clip is uploaded to the `companion/clips`
# bucket automatically. The SERVICE key is a powerful secret — keep it here,
# never in frontend code. Leave blank to upload manually via the dashboard.
SUPABASE_URL=https://cjbfdcgopbpjifnxcslt.supabase.co
SUPABASE_SERVICE_KEY=

# ── OPTIONAL tunables (sensible defaults if omitted) ──────
CLIP_DURATION=6          # seconds, 1-15
CLIP_RESOLUTION=480p     # 480p | 720p | 1080p  (480p = smaller/cheaper, fine for the orb)
CLIP_ASPECT_RATIO=1:1    # 1:1 is ideal for the circular companion orb
CLIP_CONCURRENCY=3       # how many generations to run at once
